# Spotify application credentials (https://developer.spotify.com/dashboard).
# The app only uses the Client Credentials flow, so no redirect URI is needed.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# MusicBrainz asks anonymous clients to identify themselves with a contact
# address. Requests are rate limited to one per second and cached for 30 days.
MUSICBRAINZ_CONTACT=your-name <you@example.com>

# --- Discovery window -------------------------------------------------------
# RADAR_MARKETS=SE
# RADAR_DAYS=14
# RADAR_MAX_ALBUMS=400

# --- Thresholds -------------------------------------------------------------
# RADAR_MIN_CONFIDENCE=0.55
# RADAR_WRITER_MAJORITY=0.5

# --- Budgets (MusicBrainz allows ~1 request/second) -------------------------
# RADAR_MUSICBRAINZ_BUDGET=600
# RADAR_WRITER_RELEASE_BUDGET=60
# RADAR_WRITER_TRACK_SAMPLE=4

# --- Storage ----------------------------------------------------------------
# RADAR_CACHE_PATH=~/.cache/swedish-radar/cache.sqlite3
# RADAR_STORE_PATH=swedish-radar.sqlite3
# RADAR_MUSICBRAINZ=1
# RADAR_CACHE=1
